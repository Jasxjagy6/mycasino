# =============================================================================
# mycasino .env -- copy to .env and fill in.  Every secret can be overridden
# at the OS env level too.
# =============================================================================

# --- Core bot ----------------------------------------------------------------
BOT_TOKEN=replace-me
HELPER_BOT_TOKEN=
HELPER_BOT_2_TOKEN=
HELPER_BOT_3_TOKEN=
HELPER_BOT_4_TOKEN=
HELPER_BOT_5_TOKEN=
HELPER_BOT_6_TOKEN=

# Comma-separated Telegram user IDs allowed to run admin commands
# (incl. /reload, /listplugins, /runtimestatus).
BOT_OWNER_IDS=6083286836

# --- Webhook (single-instance) ----------------------------------------------
# When WEBHOOK_ENABLED is set in bot.py, the bot starts in webhook mode.
# Use the blue-green wrapper (deploy/blue_green_switch.sh) for production.
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-domain.example.com/bot_webhook
WEBHOOK_PORT=8443

# --- Zero-downtime runtime ---------------------------------------------------
# Auto-load every module under plugins/ at startup.
MYCASINO_AUTOLOAD_PLUGINS=1

# Optional: only load specific plugins (comma-separated short names).
# MYCASINO_PLUGIN_ALLOWLIST=example_blackjack,example_dice

# Optional: skip these plugins.
# MYCASINO_PLUGIN_DENYLIST=

# Identifier for the active blue/green color (set by deploy script).
MYCASINO_COLOR=blue

# --- Decoupled / queue mode (Redis Streams) ---------------------------------
MYCASINO_REDIS_URL=redis://localhost:6379/0
MYCASINO_QUEUE_STREAM=mycasino:updates
MYCASINO_QUEUE_GROUP=mycasino-workers
MYCASINO_QUEUE_MAXLEN=100000

MYCASINO_RECEIVER_HOST=0.0.0.0
MYCASINO_RECEIVER_PORT=8200
MYCASINO_RECEIVER_PATH=/bot_webhook
# If set, MUST match Telegram setWebhook ?secret_token=...
MYCASINO_RECEIVER_SECRET=

# Worker tuning
MYCASINO_QUEUE_BATCH_SIZE=32
MYCASINO_QUEUE_BLOCK_MS=5000
MYCASINO_QUEUE_AUTOCLAIM=1
MYCASINO_QUEUE_CLAIM_IDLE_MS=60000
# module:callable; default bot:_build_worker_application
MYCASINO_APP_FACTORY=bot:_build_worker_application

# --- CWallet Deposit Integration --------------------------------------------
# The Telegram username that receives tips (without @)
CWALLET_RECEIVE_USERNAME=jashanxjagy
# Optional: CWallet bot username (default: Cwallet_com_Bot)
CWALLET_BOT_USERNAME=Cwallet_com_Bot
# Optional: Webhook listener port (default: 8091)
CWALLET_WEBHOOK_PORT=8091
# Optional: Secret for webhook signature verification
CWALLET_WEBHOOK_SECRET=
# Optional: CWallet API key (for polling mode)
CWALLET_API_KEY=
CWALLET_API_SECRET=
