# =============================================================================
# mycasino .env -- copy to .env and fill in.  Every secret can be overridden
# at the OS env level too.
# =============================================================================

# --- Core bot ----------------------------------------------------------------
BOT_TOKEN=replace-me
HELPER_BOT_TOKEN=
HELPER_BOT_2_TOKEN=
HELPER_BOT_3_TOKEN=
HELPER_BOT_4_TOKEN=
HELPER_BOT_5_TOKEN=
HELPER_BOT_6_TOKEN=

# Comma-separated Telegram user IDs allowed to run admin commands
# (incl. /reload, /listplugins, /runtimestatus).
BOT_OWNER_IDS=6083286836

# --- Webhook (single-instance) ----------------------------------------------
# When WEBHOOK_ENABLED is set in bot.py, the bot starts in webhook mode.
# Use the blue-green wrapper (deploy/blue_green_switch.sh) for production.
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-domain.example.com/bot_webhook
WEBHOOK_PORT=8443

# --- Zero-downtime runtime ---------------------------------------------------
# Auto-load every module under plugins/ at startup.
MYCASINO_AUTOLOAD_PLUGINS=1

# Optional: only load specific plugins (comma-separated short names).
# MYCASINO_PLUGIN_ALLOWLIST=example_blackjack,example_dice

# Optional: skip these plugins.
# MYCASINO_PLUGIN_DENYLIST=

# Identifier for the active blue/green color (set by deploy script).
MYCASINO_COLOR=blue

# --- Decoupled / queue mode (Redis Streams) ---------------------------------
MYCASINO_REDIS_URL=redis://localhost:6379/0
MYCASINO_QUEUE_STREAM=mycasino:updates
MYCASINO_QUEUE_GROUP=mycasino-workers
MYCASINO_QUEUE_MAXLEN=100000

MYCASINO_RECEIVER_HOST=0.0.0.0
MYCASINO_RECEIVER_PORT=8200
MYCASINO_RECEIVER_PATH=/bot_webhook
# If set, MUST match Telegram setWebhook ?secret_token=...
MYCASINO_RECEIVER_SECRET=

# Worker tuning
MYCASINO_QUEUE_BATCH_SIZE=32
MYCASINO_QUEUE_BLOCK_MS=5000
MYCASINO_QUEUE_AUTOCLAIM=1
MYCASINO_QUEUE_CLAIM_IDLE_MS=60000
# module:callable; default bot:_build_worker_application
MYCASINO_APP_FACTORY=bot:_build_worker_application

# --- Phase 2: Postgres wallet+ledger ----------------------------------------
# Set POSTGRES_URL to enable the PG ledger.  Leave MYCASINO_PG_LEDGER unset
# to keep the legacy in-memory wallet path running for a soft rollout.
POSTGRES_URL=
MYCASINO_PG_LEDGER=
MYCASINO_PG_MIN_POOL=2
MYCASINO_PG_MAX_POOL=20
MYCASINO_PG_STATEMENT_TIMEOUT=5000
# Override the location of deploy/migrations/00xx_*.sql (rare).
# MYCASINO_PG_MIGRATIONS_DIR=

# --- Phase 2: Redis hot-state backbone --------------------------------------
# When MYCASINO_REDIS_BACKEND is unset, rate-limit / leaderboard / jackpot /
# dedup helpers degrade to per-process memory (fine for tests, NOT for
# production multi-worker setups).
MYCASINO_REDIS_BACKEND=
MYCASINO_LEADERBOARD_TTL=691200
MYCASINO_JACKPOT_KEY_PREFIX=mycasino:jackpot:

# --- Phase 3: persistence backend -------------------------------------------
# 'postgres' routes user_state writes to the PG user_state table; anything
# else (or unset) keeps the legacy JSON-on-disk path.
MYCASINO_PERSIST_BACKEND=
# Force-fall-back to JSON even if POSTGRES_URL is set (used by audits/tests).
MYCASINO_PERSIST_BACKEND_FORCE_JSON=
# Override the JSON data dir; default <repo>/data/users.
# MYCASINO_DATA_DIR=

# --- Phase 4: observability -------------------------------------------------
# Switch the root logger to one JSON line per record.
MYCASINO_LOG_JSON=
MYCASINO_LOG_LEVEL=INFO
# Bind address for runtime/metrics_server.py.
MYCASINO_METRICS_HOST=0.0.0.0
MYCASINO_METRICS_PORT=9100
# Max seconds since last heartbeat before /healthz returns 503.
MYCASINO_HEALTH_MAX_AGE=60
# Sentry — optional.  When set AND sentry-sdk is installed, errors flow up.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
MYCASINO_ENV=production
