[Unit]
Description=mycasino Prometheus metrics endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mycasino
Group=mycasino
WorkingDirectory=/opt/mycasino
EnvironmentFile=-/etc/mycasino/metrics.env
ExecStart=/opt/mycasino/.venv/bin/python -m runtime.metrics_server
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
